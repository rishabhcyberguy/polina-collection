rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All POLINA browser reads and writes go through the server API.
    // Firebase Admin SDK server operations bypass these client security rules;
    // the server independently verifies ID tokens and active-admin records.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
