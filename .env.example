# POLINA runtime configuration. Never commit a populated .env file.

# Required by the server for Firebase Admin Auth and the named Firestore database.
# Paste the downloaded service-account JSON only into protected runtime secrets.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional nonsecret overrides; default to firebase-applet-config.json values.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=

# Optional nonsecret override; defaults to storageBucket in firebase-applet-config.json.
FIREBASE_STORAGE_BUCKET=

# Optional Manus API access for Manus-backed auxiliary features; not used for Vercel media storage.
MANUS_API_URL=
MANUS_API_KEY=

# Optional canonical production origin for SEO and social metadata.
PUBLIC_APP_ORIGIN=

# Firebase browser configuration is loaded from firebase-applet-config.json.
# Never place service-account credentials in frontend files or VITE_* variables.
